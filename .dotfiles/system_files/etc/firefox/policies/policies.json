{
	"policies": {
		"AIControls": {
			"Default": {
				"Value": "blocked"
			}
		},
		"ClearOnShutdown": {
			"BrowsingHistoryAndDownloads": true,
			"CookiesAndStorage": true,
			"Cache": true,
			"FormData": true
		},
		"ExtensionSettings": {
			"uBlock0@raymondhill.net": {
				"installation_mode": "force_installed",
				"private_browsing": true,
				"default_area": "navbar",
				"install_url": "https://addons.mozilla.org/firefox/downloads/latest/uBlock0@raymondhill.net/latest.xpi"
			},
			"vimium-c@gdh1995.cn": {
				"installation_mode": "force_installed",
				"private_browsing": true,
				"default_area": "menupanel",
				"install_url": "https://addons.mozilla.org/firefox/downloads/latest/vimium-c@gdh1995.cn/latest.xpi"
			},
			"keepassxc-browser@keepassxc.org": {
				"installation_mode": "force_installed",
				"private_browsing": true,
				"default_area": "menupanel",
				"install_url": "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser@keepassxc.org/latest.xpi"
			}
		},
		"SearchEngines": {
			"Default": "custom ddg",
			"Add": [
				{
					"Name": "custom ddg",
					"URLTemplate": "https://noai.duckduckgo.com/",
					"Method": "POST",
					"Alias": ":ddg",
					"PostData": "q={searchTerms}&kg=p&kc=-1&kav=-1&kae=d&kj=7750AA&k7=222222&kaj=m&ks=s"
				},
				{
					"Name": "OSM",
					"URLTemplate": "https://www.openstreetmap.org/search?query=%s",
					"Method": "GET",
					"Alias": ":osm"
				}
			],
			"Remove": [
				"DuckDuckGo",
				"Bing",
				"Perplexity"
			]
		}
	}
}
